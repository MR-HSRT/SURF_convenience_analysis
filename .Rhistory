# Korrigiertes Mapping (Codes 1 und 4 getauscht, da Datenlage eindeutig)
housing_labels <- c(
"1" = "Eigentum (EFH/RH)",
"2" = "Miete (EFH/RH)",
"3" = "Eigentum (Whg.)",
"4" = "Miete (Mehrp.h.)"
)
housing_data <- daten_analysis |>
dplyr::filter(!is.na(wohn)) |>
dplyr::mutate(label = factor(housing_labels[as.character(wohn)], levels = housing_labels)) |>
dplyr::count(owner_group, label) |>
dplyr::group_by(owner_group) |>
dplyr::mutate(pct = n / sum(n)) |>
dplyr::ungroup()
p_housing <- ggplot2::ggplot(housing_data, ggplot2::aes(x = pct, y = label, fill = owner_group)) +
ggplot2::geom_col(position = "dodge", width = 0.7) +
ggplot2::geom_text(ggplot2::aes(label = scales::percent(pct, accuracy = 1)),
position = ggplot2::position_dodge(width = 0.7), hjust = -0.1, size = 3, fontface = "bold") +
ggplot2::scale_fill_manual(values = c("Gerätebesitzer" = SURF_PURPLE, "Nicht-Besitzer" = SURF_PINK)) +
ggplot2::scale_x_continuous(labels = scales::percent, limits = c(0, max(housing_data$pct)*1.2)) +
ggplot2::labs(title = "Wohnform der Befragten", x = "Anteil (%)", y = NULL) +
theme_surf() + surf_legend_bottom()
brand_plot_surf(p_housing)
